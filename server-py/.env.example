# ===== App =====
DEVFLOW_ENV=dev
DEVFLOW_DEBUG=true
DEVFLOW_HOST=0.0.0.0
DEVFLOW_PORT=4000
DEVFLOW_API_PREFIX=/api
DEVFLOW_CORS_ORIGINS=http://localhost:5173

# ===== Security =====
DEVFLOW_JWT_SECRET=change-me-in-production
DEVFLOW_JWT_ALG=HS256
DEVFLOW_JWT_EXPIRE_MIN=720
DEVFLOW_RBAC_ENABLED=false

# ===== PostgreSQL =====
DEVFLOW_PG_DSN=postgresql+asyncpg://devflow:devflow@localhost:5432/devflow
DEVFLOW_PG_POOL_SIZE=20
DEVFLOW_PG_MAX_OVERFLOW=10

# ===== Redis =====
DEVFLOW_REDIS_URL=redis://localhost:6379/0

# ===== MinIO =====
DEVFLOW_MINIO_ENDPOINT=localhost:9000
DEVFLOW_MINIO_ACCESS_KEY=minioadmin
DEVFLOW_MINIO_SECRET_KEY=minioadmin
DEVFLOW_MINIO_BUCKET=devflow
DEVFLOW_MINIO_SECURE=false

# ===== AI providers =====
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
DEVFLOW_DEFAULT_EMBEDDING_MODEL=text-embedding-3-small
DEVFLOW_DEFAULT_EMBEDDING_DIM=1536

# ===== Tenant (单租户内部使用) =====
DEVFLOW_DEFAULT_TENANT=default

# ===== Telemetry =====
DEVFLOW_OTEL_ENABLED=false
DEVFLOW_OTEL_ENDPOINT=http://localhost:4317
